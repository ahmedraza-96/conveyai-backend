# Copy this file to .env.development (for `pnpm start:dev`) or .env.production
# (for `pnpm start:prod`) and fill in the values. The Zod schema in
# src/config/config.service.ts is the source of truth — the server refuses to
# boot if any required value is missing.

# --- App ---
PORT=3002
NODE_ENV=development

# --- Frontend origin (used for CORS and email links) ---
CLIENT_SIDE_URL=http://localhost:3000

# --- Backend public URL (used for Vapi webhook callbacks) ---
BACKEND_URL=http://localhost:3002

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES_IN=86400
SESSION_EXPIRES_IN=86400
PASSWORD_RESET_TOKEN_EXPIRES_IN=86400
SET_PASSWORD_TOKEN_EXPIRES_IN=86400
SET_SESSION=0
OTP_VERIFICATION_ENABLED=0

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Databases ---
REDIS_URL=redis://localhost:6379
MONGO_DATABASE_URL=mongodb://localhost:27017/conveyai

# --- Admin seed account ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- AWS S3 (resume uploads) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=

# --- Email (Mailgun) ---
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=

# --- Legacy SMTP (optional, used instead of Mailgun if set) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_FROM=

# --- LLM providers ---
# OpenAI is primary, Gemini is the fallback.
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=

# --- Vapi (voice interview) ---
# Sign up at https://vapi.ai — you need a private key (server), public key
# (browser), and webhook signing secret.
VAPI_API_KEY=
VAPI_PUBLIC_KEY=
VAPI_WEBHOOK_SECRET=

# --- TTS providers (voice preview samples in settings) ---
# ElevenLabs covers English voices; Azure Speech covers Urdu voices.
ELEVENLABS_API_KEY=
AZURE_TTS_KEY=
AZURE_TTS_REGION=

# --- Tavus (avatar interview type, optional — free tier: 25 min/month) ---
# https://platform.tavus.io — create a persona and copy its ID.
TAVUS_API_KEY=
TAVUS_PERSONA_MALE_ID=
